.DS_Store
.build/
.swiftpm/
*.xcodeproj
Package.resolved

# Build-time only, for `sod-build`. Test fixtures under Tests/SodTests/Fixtures/
# are checked in on purpose so consumers (and `swift test`) need no Node toolchain.
node_modules/
package-lock.json
npm/dist/

# Turbo's per-package run cache. Standalone Sod builds with tsdown, but when this
# package is consumed as a submodule inside a Turborepo monorepo, `turbo run build`
# writes .turbo/ here. Ignore it so the submodule working tree stays clean.
.turbo/
