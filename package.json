{
  "name": "sod",
  "private": true,
  "workspaces": [
    "npm"
  ],
  "type": "module",
  "scripts": {
    "postinstall": "npm rebuild @sod/build",
    "prebuild": "npm run build --workspace @sod/build",
    "build": "sod build",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix"
  },
  "devDependencies": {
    "@sod/build": "workspace:*",
    "esbuild": "0.28.0",
    "oxfmt": "0.64.0",
    "oxlint": "1.79.0",
    "zod": "4.4.3"
  }
}
